# Copie para .env.local. Nenhuma variável aqui vai para o navegador (não há NEXT_PUBLIC_*).
# Branch Neon de DESENVOLVIMENTO. Veja o README para obter cada valor sem exibi-lo.

# --- Gravadas por `neon link --branch development` (conexão do DONO do banco) ---
# Usadas SOMENTE pelos scripts de migração/provisionamento. O app recusa usar o dono.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development

# --- Neon Auth (Managed Better Auth) ---
# URL da branch: `neon neon-auth status --branch development` (campo Base URL).
NEON_AUTH_BASE_URL=
# Segredo local (mín. 32 caracteres) que assina o cache de sessão: npm run env:set -- NEON_AUTH_COOKIE_SECRET --random
NEON_AUTH_COOKIE_SECRET=

# --- Conexão do APP (papel app_runtime, sem BYPASSRLS) ---
# Gravada por: npm run db:provision-runtime
APP_DATABASE_URL=

# --- Opcionais ---
# URL local do app (links de senha e testes). Padrão: http://localhost:3000
# APP_URL=
# Contas FICTÍCIAS de teste, gravadas por: npm run auth:create-test-users
# RLS_TEST_A_EMAIL=
# RLS_TEST_A_PASSWORD=
# RLS_TEST_A_ID=
# RLS_TEST_B_EMAIL=
# RLS_TEST_B_PASSWORD=
# RLS_TEST_B_ID=
