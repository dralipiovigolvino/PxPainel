{
  "name": "app-pessoal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.local scripts/rls-check.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:provision-runtime": "node --env-file-if-exists=.env.local scripts/db-provision-runtime.mjs",
    "env:set": "node scripts/env-set.mjs",
    "auth:send-link": "node --env-file-if-exists=.env.local scripts/auth-send-link.mjs",
    "auth:create-test-users": "node --env-file-if-exists=.env.local scripts/auth-create-test-users.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/e2e-auth.mjs",
    "test:e2e:financas": "node --env-file-if-exists=.env.local scripts/e2e-financas.mjs",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "test:e2e:followup": "node --env-file-if-exists=.env.local scripts/e2e-followup.mjs",
    "test:e2e:plantoes": "node --env-file-if-exists=.env.local scripts/e2e-plantoes.mjs",
    "test:e2e:dashboard": "node --env-file-if-exists=.env.local scripts/e2e-dashboard.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.local scripts/db-restore.mjs",
    "db:restore-drill": "node --env-file-if-exists=.env.local scripts/db-restore-drill.mjs",
    "test:e2e:acesso": "node --env-file-if-exists=.env.local scripts/e2e-acesso.mjs",
    "test:visual": "node --env-file-if-exists=.env.local scripts/revisao-visual.mjs",
    "test:e2e:ajustes": "node --env-file-if-exists=.env.local scripts/e2e-ajustes.mjs",
    "test:e2e:atualizacao-1": "node --env-file-if-exists=.env.local scripts/e2e-atualizacao-1.mjs"
